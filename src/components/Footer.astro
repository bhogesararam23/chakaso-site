---
import StatusBadge from './StatusBadge.astro';
---

<footer class="relative bg-[#050608] border-t border-white/[0.07] pt-16 pb-12 px-6 md:px-12 overflow-hidden">
  <!-- Subtle top glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-[1px] bg-gradient-to-r from-transparent via-indigo-500/30 to-transparent"></div>

  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-white/[0.06]">
      
      <!-- Brand & Mission statement (Col 1-4) -->
      <div class="md:col-span-4 flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <div class="w-7 h-7 rounded border border-white/10 bg-[#0e1117] flex items-center justify-center">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none">
              <path d="M12 3L20 7.5V16.5L12 21L4 16.5V7.5L12 3Z" stroke="#818cf8" stroke-width="1.5"/>
              <circle cx="12" cy="12" r="2" fill="#a855f7"/>
            </svg>
          </div>
          <span class="font-mono text-sm uppercase tracking-widest text-slate-100 font-semibold">Chakaso</span>
        </div>

        <p class="text-sm text-slate-300 max-w-sm leading-relaxed font-sans">
          An independent exploration of compact language models, subword tokenization, and empirical evaluation harnesses.
        </p>

        <div class="flex items-center gap-2 pt-2">
          <StatusBadge status="Experimenting" size="sm" />
          <span class="text-xs font-mono text-slate-400">Chakaso Base 0.1.0 · Level 2</span>
        </div>
      </div>

      <!-- Research Program (Col 5-7) -->
      <div class="md:col-span-3 flex flex-col gap-3">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-300 font-semibold">Research Program</span>
        <ul class="flex flex-col gap-2 text-sm text-slate-300">
          <li><a href="/research" class="hover:text-indigo-400 transition-colors">Program Overview</a></li>
          <li><a href="/research/experiments" class="hover:text-indigo-400 transition-colors">Experiment Archive (E2601–E2636)</a></li>
          <li><a href="/research/methodology" class="hover:text-indigo-400 transition-colors">Methodology & Error Bands</a></li>
          <li><a href="/research/data" class="hover:text-indigo-400 transition-colors">Data Provenance & Corpora</a></li>
          <li><a href="/research/evaluation" class="hover:text-indigo-400 transition-colors">Evaluation & Split Integrity</a></li>
        </ul>
      </div>

      <!-- System & Docs (Col 8-10) -->
      <div class="md:col-span-3 flex flex-col gap-3">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-300 font-semibold">System & Artifacts</span>
        <ul class="flex flex-col gap-2 text-sm text-slate-300">
          <li><a href="/models" class="hover:text-indigo-400 transition-colors">Chakaso Base 0.1.0 Profile</a></li>
          <li><a href="/architecture" class="hover:text-indigo-400 transition-colors">Causal Decoder Architecture</a></li>
          <li><a href="/docs" class="hover:text-indigo-400 transition-colors">Technical Documentation</a></li>
          <li><a href="/journal" class="hover:text-indigo-400 transition-colors">Architectural Decision Records</a></li>
          <li><a href="/about" class="hover:text-indigo-400 transition-colors">Principles & Ethos</a></li>
        </ul>
      </div>

      <!-- Provenance & Source (Col 11-12) -->
      <div class="md:col-span-2 flex flex-col gap-3">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-300 font-semibold">Repository</span>
        <div class="flex flex-col gap-2 text-sm text-slate-300">
          <a
            href="https://github.com/bhogesararam23/chakaso"
            target="_blank"
            rel="noopener noreferrer"
            class="text-indigo-400/90 hover:text-indigo-300 transition-colors inline-flex items-center gap-1.5"
          >
            <span>Model Repository</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
          <a
            href="https://github.com/bhogesararam23/chakaso-site"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-300 hover:text-slate-100 transition-colors inline-flex items-center gap-1.5"
          >
            <span>Website Source</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
          <span class="text-xs font-mono text-slate-400 pt-1">License: Apache-2.0</span>
        </div>
      </div>

    </div>

    <!-- Bottom metadata bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-400">
      <div>
        <span>&copy; {new Date().getFullYear()} Chakaso Research Initiative.</span>
      </div>
      <div class="flex items-center gap-6">
        <span>Deterministic Seeds</span>
        <span>Whole-Work Splits</span>
        <span>Level 2 Release Gate</span>
      </div>
    </div>
  </div>
</footer>
