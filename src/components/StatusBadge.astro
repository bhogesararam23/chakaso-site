---
interface Props {
  status: 'Implemented' | 'Experimenting' | 'Planned' | 'Conceptual';
  size?: 'sm' | 'md';
}

const { status, size = 'sm' } = Astro.props;

const statusConfig = {
  Implemented: {
    bg: 'bg-emerald-500/10',
    border: 'border-emerald-500/30',
    text: 'text-emerald-400',
    dot: 'bg-emerald-400'
  },
  Experimenting: {
    bg: 'bg-amber-500/10',
    border: 'border-amber-500/30',
    text: 'text-amber-400',
    dot: 'bg-amber-400'
  },
  Planned: {
    bg: 'bg-sky-500/10',
    border: 'border-sky-500/30',
    text: 'text-sky-400',
    dot: 'bg-sky-400'
  },
  Conceptual: {
    bg: 'bg-purple-500/10',
    border: 'border-purple-500/30',
    text: 'text-purple-400',
    dot: 'bg-purple-400'
  }
};

const current = statusConfig[status];
const sizeClasses = size === 'sm' ? 'px-2 py-0.5 text-[11px]' : 'px-2.5 py-1 text-xs';
---

<span class={`inline-flex items-center gap-1.5 font-mono uppercase tracking-wider rounded border ${current.bg} ${current.border} ${current.text} ${sizeClasses}`}>
  <span class={`w-1.5 h-1.5 rounded-full ${current.dot} animate-pulse`}></span>
  <span>{status}</span>
</span>
