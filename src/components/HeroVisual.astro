---
// Technical Model Specification & Architecture Schematic
// Reflects the exact 3,413,760-parameter causal decoder implemented in chakaso.training.decoder
---

<div class="w-full max-w-xl mx-auto">
  <div class="rounded-2xl border border-white/[0.1] bg-[#0c0e12] p-6 sm:p-7 shadow-2xl relative">
    
    <!-- Header Block -->
    <div class="flex items-start justify-between pb-4 border-b border-white/[0.08] mb-5">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span class="font-mono text-[11px] uppercase tracking-wider text-slate-300 font-semibold">
            Baseline Architecture Schematic
          </span>
        </div>
        <div class="text-xs font-mono text-slate-400 mt-1">
          chakaso-base@0.1.0 · Causal Decoder Transformer
        </div>
      </div>
      <div class="text-right font-mono">
        <span class="text-xs text-indigo-400 font-bold px-2.5 py-1 rounded bg-indigo-500/10 border border-indigo-500/20">
          3,413,760 params
        </span>
      </div>
    </div>

    <!-- Tensor Dimensions Strip -->
    <div class="grid grid-cols-4 gap-2 mb-5 font-mono text-center text-xs">
      <div class="p-2.5 rounded-lg border border-white/[0.06] bg-white/[0.02]">
        <span class="text-xs text-slate-400 block font-medium">d_model</span>
        <span class="text-sm font-semibold text-white">256</span>
      </div>
      <div class="p-2.5 rounded-lg border border-white/[0.06] bg-white/[0.02]">
        <span class="text-xs text-slate-400 block font-medium">n_layers</span>
        <span class="text-sm font-semibold text-white">6</span>
      </div>
      <div class="p-2.5 rounded-lg border border-white/[0.06] bg-white/[0.02]">
        <span class="text-xs text-slate-400 block font-medium">heads (h)</span>
        <span class="text-sm font-semibold text-white">4 × 64</span>
      </div>
      <div class="p-2.5 rounded-lg border border-white/[0.06] bg-white/[0.02]">
        <span class="text-xs text-slate-400 block font-medium">d_ffn</span>
        <span class="text-sm font-semibold text-white">1,024</span>
      </div>
    </div>

    <!-- Computational Pipeline Stages -->
    <div class="space-y-2.5 font-mono text-xs">
      
      <!-- Stage 1: Ingestion & Subword -->
      <div class="p-3 rounded-xl border border-white/[0.06] bg-[#07080a] flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-xs text-slate-400 font-semibold w-5">01</span>
          <div>
            <div class="text-slate-200 font-medium text-xs sm:text-sm">Space-Prefixed Subword BPE</div>
            <div class="text-xs text-slate-400">4,096 vocabulary · byte-level fallback · ADR-0051</div>
          </div>
        </div>
        <span class="text-xs text-slate-400">T ≤ 256</span>
      </div>

      <!-- Arrow down connector -->
      <div class="flex justify-center text-slate-500 text-xs -my-1">↓</div>

      <!-- Stage 2: Embedding & Positional Encoding -->
      <div class="p-3 rounded-xl border border-white/[0.06] bg-[#07080a] flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-xs text-slate-400 font-semibold w-5">02</span>
          <div>
            <div class="text-slate-200 font-medium text-xs sm:text-sm">Embedding & Rotary Encodings</div>
            <div class="text-xs text-slate-400">Dense projection to ℝ²⁵⁶ + RoPE pairwise rotation</div>
          </div>
        </div>
        <span class="text-xs text-indigo-400 font-semibold">RoPE</span>
      </div>

      <!-- Arrow down connector -->
      <div class="flex justify-center text-slate-500 text-xs -my-1">↓</div>

      <!-- Stage 3: Stacked Transformer Blocks (x6) -->
      <div class="p-3.5 rounded-xl border border-indigo-500/30 bg-indigo-950/15">
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-2">
            <span class="text-xs text-indigo-400 font-semibold w-5">03</span>
            <span class="text-white font-semibold text-xs sm:text-sm">6× Causal Decoder Blocks</span>
          </div>
          <span class="text-xs text-indigo-300 uppercase px-2 py-0.5 rounded bg-indigo-500/20 font-medium">Repeated Stack</span>
        </div>
        
        <div class="grid grid-cols-2 gap-2 mt-2 pt-2 border-t border-indigo-500/20 text-xs">
          <div class="p-2 rounded bg-black/40 border border-white/[0.04]">
            <div class="text-slate-300 font-medium">Pre-LN Attention</div>
            <div class="text-slate-400 text-xs">RMSNorm → Causal MHA</div>
          </div>
          <div class="p-2 rounded bg-black/40 border border-white/[0.04]">
            <div class="text-slate-300 font-medium">Pre-LN Feed-Forward</div>
            <div class="text-slate-400 text-xs">RMSNorm → GELU FFN (1,024)</div>
          </div>
        </div>
      </div>

      <!-- Arrow down connector -->
      <div class="flex justify-center text-slate-500 text-xs -my-1">↓</div>

      <!-- Stage 4: Logit Output -->
      <div class="p-3 rounded-xl border border-white/[0.06] bg-[#07080a] flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-xs text-slate-400 font-semibold w-5">04</span>
          <div>
            <div class="text-slate-200 font-medium text-xs sm:text-sm">Final RMSNorm & Output Logits</div>
            <div class="text-xs text-slate-400">Projection to 4,096 logits · Bounded decoding (ADR-0038)</div>
          </div>
        </div>
        <span class="text-[11px] text-emerald-400">P(x_t)</span>
      </div>

    </div>

    <!-- Empirical Verification Footer -->
    <div class="mt-5 pt-4 border-t border-white/[0.08] flex items-center justify-between text-[11px] font-mono text-slate-400">
      <div>
        <span>Split: </span>
        <span class="text-slate-300">Within-work (1.6865 bpc, ADR-0042)</span>
      </div>
      <div>
        <a href="/architecture" class="text-indigo-400 hover:text-indigo-300 hover:underline">
          View code contract →
        </a>
      </div>
    </div>

  </div>
</div>
