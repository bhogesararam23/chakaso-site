---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { label: 'Research', href: '/research' },
  { label: 'Architecture', href: '/architecture' },
  { label: 'Models', href: '/models' },
  { label: 'Journal', href: '/journal' },
  { label: 'About', href: '/about' }
];

const isActive = (path: string) => {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
};
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 py-4 px-6 md:px-12 backdrop-blur-md bg-[#07080a]/60 border-b border-white/[0.05]">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 rounded-lg p-1" aria-label="Chakaso Homepage">
      <!-- Geometric Monogram -->
      <div class="w-8 h-8 rounded-md border border-white/10 bg-[#0e1117] flex items-center justify-center transition-transform duration-300 group-hover:border-indigo-500/50 group-hover:scale-105">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
          <path d="M12 3L20 7.5V16.5L12 21L4 16.5V7.5L12 3Z" stroke="#818cf8" stroke-width="1.5" stroke-linejoin="round"/>
          <circle cx="12" cy="12" r="2.5" fill="#a855f7"/>
          <line x1="12" y1="3" x2="12" y2="9.5" stroke="#38bdf8" stroke-width="1" stroke-dasharray="1 1"/>
          <line x1="12" y1="14.5" x2="12" y2="21" stroke="#38bdf8" stroke-width="1" stroke-dasharray="1 1"/>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-semibold tracking-wider text-slate-100 group-hover:text-white transition-colors uppercase font-mono">Chakaso</span>
        <span class="text-[9px] text-slate-500 tracking-widest uppercase font-mono hidden sm:inline">Research</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 bg-[#0e1117]/80 border border-white/[0.08] px-3 py-1.5 rounded-full shadow-inner shadow-black/40" aria-label="Main Navigation">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`relative px-4 py-1.5 text-xs font-medium tracking-wide transition-colors rounded-full ${
              active 
                ? 'text-white bg-white/[0.08] border border-white/10 shadow-sm' 
                : 'text-slate-400 hover:text-slate-200 hover:bg-white/[0.03]'
            }`}
          >
            {item.label}
            {active && (
              <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-indigo-400 animate-pulse"></span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Right Action: GitHub Link & Mobile Menu Toggle -->
    <div class="flex items-center gap-3">
      <a
        href="https://github.com/bhogesararam23/chakaso"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-white/10 bg-[#0e1117]/80 hover:bg-[#151922] text-xs font-mono text-slate-300 hover:text-white transition-all hover:border-indigo-500/40"
        aria-label="GitHub Repository"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        <span>Repo</span>
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="md:hidden p-2 text-slate-400 hover:text-white rounded-lg border border-white/10 bg-[#0e1117] focus:outline-none"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16m-7 6h7"/>
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden mt-3 px-4 py-4 rounded-xl border border-white/10 bg-[#0b0d12]/95 backdrop-blur-xl shadow-2xl transition-all">
    <div class="flex flex-col gap-2">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`px-3 py-2 rounded-lg text-sm font-medium tracking-wide transition-colors flex items-center justify-between ${
              active 
                ? 'text-white bg-white/[0.08] border border-white/10' 
                : 'text-slate-400 hover:text-white hover:bg-white/[0.03]'
            }`}
          >
            <span>{item.label}</span>
            {active && <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>}
          </a>
        );
      })}
      <div class="pt-3 border-t border-white/[0.08] mt-1 flex justify-between items-center px-1">
        <a
          href="https://github.com/bhogesararam23/chakaso"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-xs font-mono text-slate-400 hover:text-white"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <span>github.com/bhogesararam23/chakaso</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu interactive toggle with keyboard accessibility
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  if (btn && menu && openIcon && closeIcon) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        btn.setAttribute('aria-expanded', 'false');
        menu.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        btn.focus();
      }
    });
  }

  // Header scroll appearance
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) {
      header?.classList.add('py-3', 'bg-[#07080a]/90', 'border-white/10');
      header?.classList.remove('py-4', 'bg-[#07080a]/60', 'border-white/[0.05]');
    } else {
      header?.classList.add('py-4', 'bg-[#07080a]/60', 'border-white/[0.05]');
      header?.classList.remove('py-3', 'bg-[#07080a]/90', 'border-white/10');
    }
  }, { passive: true });
</script>
