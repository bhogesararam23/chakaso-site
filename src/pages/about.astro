---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';

const principles = [
  {
    title: 'Random Initialization',
    desc: 'Neural networks are constructed from random weight initializations using transparent, inspectable training pipelines. The project does not fine-tune black-box endpoints or claim borrowed capabilities as original work.'
  },
  {
    title: 'Explicit Provenance & Pinned Data',
    desc: 'Training text is drawn from unambiguous sources with verified licenses or public domain status. Every corpus snapshot is pinned by its SHA-256 fingerprint so identical runs can be reproduced on identical software environments.'
  },
  {
    title: 'Negative Result Transparency',
    desc: 'Empirical records document what the evidence supports. When a smaller arm ties or underperforms, or when greedy decoding collapses into repetitive loops, those outcomes are recorded as primary findings, not suppressed.'
  },
  {
    title: 'Lean, Verifiable Implementations',
    desc: 'The codebase prioritizes standard-library modules, clear interfaces, and deterministic CPU evaluation. Anyone with a Python environment can inspect the weights, verify the loss curves, and run the serving layer.'
  }
];
---

<Layout
  title="About — Chakaso"
  description="About Chakaso: an independent research initiative exploring compact language models, tokenization dynamics, and empirical evaluation harnesses."
  currentPath="/about"
>
  <div class="max-w-7xl mx-auto px-6 md:px-12 py-12">
    
    <!-- Hero / Header -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/10 bg-[#0e1117] mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
        <span class="font-mono text-xs uppercase tracking-wider text-slate-300">About Chakaso</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-white leading-tight editorial-title">
        Independent Language Model Research
      </h1>

      <p class="mt-6 text-base sm:text-lg text-slate-400 leading-relaxed font-sans">
        Chakaso is an ongoing research initiative investigating how language models behave when built, trained, and evaluated from random initialization without corporate sponsors or borrowed weights.
      </p>
    </div>

    <!-- 1. What Chakaso Is & Why It Exists -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-20 items-start">
      <div class="lg:col-span-5">
        <span class="font-mono text-xs text-indigo-400 uppercase tracking-widest block mb-2">Scope & Focus</span>
        <h2 class="text-2xl sm:text-3xl font-semibold text-white tracking-tight leading-snug">
          Why train language models from scratch?
        </h2>
      </div>

      <div class="lg:col-span-7 flex flex-col gap-6 text-sm sm:text-base text-slate-300 leading-relaxed font-sans">
        <p>
          Much of current machine learning development wraps proprietary third-party endpoints in application layers. While functional for product development, consuming hosted APIs does not clarify the underlying mechanics of sequence modeling.
        </p>
        <p>
          Chakaso was created to examine the structural foundations of autoregressive decoders directly. How do subword boundary rules impact sequence compression and downstream loss? Can a rotary decoder outperform standard absolute positional transformers under constrained budgets? What is the true measurement noise floor across random initialization seeds?
        </p>
        <p>
          The project approaches language modeling as an empirical science: training small models (1M to 3.4M parameters), running multi-seed sweeps, testing hypotheses against preregistered criteria, and recording both positive gains and negative limitations.
        </p>
      </div>
    </div>

    <!-- 2. Core Engineering Principles -->
    <div class="mb-20">
      <SectionHeader
        index="ETHOS"
        tag="PRINCIPLES"
        title="Engineering Standards"
        description="Principles governing every commit, architectural decision, and experiment in the project."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {principles.map((p, idx) => (
          <div class="p-6 rounded-xl border border-white/[0.08] bg-[#0c0e12]/80 flex flex-col justify-between">
            <div>
              <div class="font-mono text-xs text-indigo-400 font-semibold mb-3">0{idx + 1}</div>
              <h3 class="text-base font-semibold text-white mb-2">{p.title}</h3>
              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed font-sans">
                {p.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- 3. Open Source Commitment & Licensing -->
    <div class="p-8 sm:p-10 rounded-2xl border border-white/[0.08] bg-[#0c0e12] mb-12">
      <div class="max-w-3xl">
        <span class="font-mono text-xs text-indigo-400 uppercase tracking-widest block mb-2">Licensing & Provenance</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight mb-4">
          Open Software & Documented Provenance
        </h2>
        
        <div class="space-y-4 text-sm text-slate-300 leading-relaxed mb-6">
          <p>
            Chakaso maintains clear boundaries between its source code, datasets, and model checkpoints:
          </p>
          <ul class="space-y-2 font-mono text-xs text-slate-400 list-disc list-inside">
            <li><strong class="text-slate-200">Software & Documentation:</strong> Released under the permissive <strong class="text-slate-200">Apache-2.0</strong> license (ADR-0004).</li>
            <li><strong class="text-slate-200">Training Corpora:</strong> Public domain English literature from Project Gutenberg (ADR-0036) and self-authored documentation manifests.</li>
            <li><strong class="text-slate-200">Model Checkpoints:</strong> Experimental research artifacts governed by strict release gates. Chakaso Base 0.1.0 passes Level 1 (structural integrity) and Level 2 (reproducible weights), but Level 3 (useful assistant behavior) remains explicitly withheld (ADR-0039).</li>
          </ul>
        </div>

        <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-white/[0.08]">
          <a
            href="https://github.com/bhogesararam23/chakaso"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-mono text-xs uppercase tracking-wider transition-colors flex items-center gap-2"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>Research Repository</span>
          </a>

          <a
            href="/models"
            class="px-5 py-2.5 rounded-lg border border-white/10 hover:border-white/20 bg-[#0e1117] text-slate-300 hover:text-white font-mono text-xs uppercase tracking-wider transition-colors"
          >
            Review Baseline Metrics
          </a>
        </div>
      </div>
    </div>

  </div>
</Layout>
