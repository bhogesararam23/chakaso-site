---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';

const principles = [
  {
    title: 'First Principles Construction',
    desc: 'We construct neural networks from random weight initializations, using known, inspectable training pipelines. We do not fine-tune black-box closed models and claim to have discovered new intelligence.'
  },
  {
    title: 'Complete Provenance Accounting',
    desc: 'Training text must come from unambiguous sources with clear licenses (Apache-2.0, public domain). Every corpus snapshot is frozen by its SHA-256 fingerprint so identical runs can be reproduced decades later.'
  },
  {
    title: 'Epistemic Honesty',
    desc: 'We publish what the evidence supports. When a smaller model arm ties or underperforms, or when samples degenerate into cycles, that failure is documented as an empirical fact, not suppressed.'
  },
  {
    title: 'Minimal Dependency Overhead',
    desc: 'A robust research project should run on standard hardware without an avalanche of unstable third-party wrappers. From standard-library HTTP serving to CPU CI gates, we prioritize lean, verifiable software.'
  }
];
---

<Layout
  title="About the Initiative — Chakaso"
  description="About Chakaso: an independent AI research project exploring language models, computational systems, and the foundations of machine intelligence."
  currentPath="/about"
>
  <div class="max-w-7xl mx-auto px-6 md:px-12 py-12">
    
    <!-- Hero / Header -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/10 bg-[#0e1117] mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
        <span class="font-mono text-xs uppercase tracking-wider text-slate-300">About the Initiative</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-white leading-tight editorial-title">
        Intelligence, Engineered from First Principles
      </h1>

      <p class="mt-6 text-base sm:text-lg text-slate-400 leading-relaxed font-sans">
        Chakaso is an independent AI research and engineering initiative exploring language models, computational architectures, and the foundational mathematics of machine intelligence.
      </p>
    </div>

    <!-- 1. What Chakaso Is & Why It Exists -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-20 items-start">
      <div class="lg:col-span-5">
        <span class="font-mono text-xs text-indigo-400 uppercase tracking-widest block mb-2">Genesis & Purpose</span>
        <h2 class="text-2xl sm:text-3xl font-semibold text-white tracking-tight leading-snug">
          Why build another language model from scratch?
        </h2>
      </div>

      <div class="lg:col-span-7 flex flex-col gap-6 text-sm sm:text-base text-slate-300 leading-relaxed font-sans">
        <p>
          Much of modern artificial intelligence has shifted toward API consumption: wrapping massive proprietary endpoints in thin interfaces and calling it research. In contrast, true engineering understanding requires building the computational engine from the ground up.
        </p>
        <p>
          Chakaso was initiated to interrogate the structural foundations of autoregressive modeling. How do tokenization choices impact the entropy of small sequences? How do causal attention heads interact with state-space recurrence? Can an independent researcher build a fully reproducible, self-contained model lifecycle &mdash; from tokenizer training and dataset manifests to multi-layer transformers and local HTTP streaming &mdash; with zero commercial black boxes?
        </p>
        <p>
          The name <strong class="text-white font-medium">Chakaso</strong> embodies this pursuit: a disciplined, systematic inquiry into how machine intelligence emerges when every parameter, loss curve, and gradient norm is open to inspection.
        </p>
      </div>
    </div>

    <!-- 2. Core Engineering Principles -->
    <div class="mb-20">
      <SectionHeader
        index="ETHOS"
        tag="PRINCIPLES"
        title="Core Engineering Standards"
        description="Non-negotiable principles guiding every commit, architectural decision, and experiment."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {principles.map((p, idx) => (
          <div class="p-6 rounded-xl border border-white/[0.08] bg-[#0c0e12]/80 flex flex-col justify-between">
            <div>
              <div class="font-mono text-xs text-indigo-400 font-semibold mb-3">0{idx + 1}</div>
              <h3 class="text-base font-semibold text-white mb-2">{p.title}</h3>
              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed font-sans">
                {p.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- 3. Open Source Commitment & Long-Term Vision -->
    <div class="p-8 sm:p-12 rounded-2xl border border-white/[0.08] bg-[#0a0d13] mb-12">
      <div class="max-w-3xl">
        <span class="font-mono text-xs text-indigo-400 uppercase tracking-widest block mb-2">Long-Term Orientation</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight mb-4">
          Open-Source, Transparent, and Grounded
        </h2>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-6">
          Chakaso operates under the Apache-2.0 open-source license. We believe the future of robust intelligence systems relies on inspectability, verification boundaries, and rigorous scientific accounting.
        </p>

        <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-white/[0.08]">
          <a
            href="https://github.com/bhogesararam23/chakaso"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-mono text-xs uppercase tracking-wider transition-colors flex items-center gap-2"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>GitHub Repository</span>
          </a>

          <a
            href="/models"
            class="px-5 py-2.5 rounded-lg border border-white/10 hover:border-white/20 bg-[#0e1117] text-slate-300 hover:text-white font-mono text-xs uppercase tracking-wider transition-colors"
          >
            Review Baseline Metrics
          </a>
        </div>
      </div>
    </div>

  </div>
</Layout>
