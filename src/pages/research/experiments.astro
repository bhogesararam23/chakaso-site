---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ExperimentArchive from '../../components/ExperimentArchive';
---

<Layout
  title="Experiment Archive (E2601–E2636) — Chakaso"
  description="Searchable, filterable archive of verified language-model research experiments conducted in the Chakaso codebase."
  currentPath="/research/experiments"
>
  <div class="max-w-7xl mx-auto px-6 md:px-12 py-12">
    <!-- Breadcrumb & Header -->
    <div class="mb-10">
      <div class="flex items-center gap-2 font-mono text-xs text-indigo-400 uppercase tracking-widest mb-4">
        <a href="/research" class="hover:underline">Research</a>
        <span class="text-slate-600">/</span>
        <span class="text-slate-300">Experiments</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-white leading-tight editorial-title">
        The Empirical Ledger
      </h1>

      <p class="mt-4 text-base sm:text-lg text-slate-400 leading-relaxed font-sans max-w-3xl">
        Every experiment conducted by Chakaso is preregistered before execution. We document what the trained weights measurably achieve, compare them strictly against trivial and competitive baselines, and report failure modes openly.
      </p>
    </div>

    <!-- Interactive Experiment Archive React Island -->
    <ExperimentArchive client:load />

    <!-- Scientific Disclaimer -->
    <div class="mt-16 p-6 rounded-2xl border border-white/[0.07] bg-[#0c0e12]/60 text-xs font-mono text-slate-400 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <span class="text-indigo-400 font-semibold uppercase">Preregistration Rule: </span>
        <span>All experiment record files are committed prior to running model arms. Results are added post-run without retroactive alteration.</span>
      </div>
      <div class="shrink-0 text-slate-500">
        Source: docs/research/research-log.md
      </div>
    </div>
  </div>
</Layout>
