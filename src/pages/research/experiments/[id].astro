---
import Layout from '../../../layouts/Layout.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import { EXPERIMENTS, type Experiment } from '../../../data/experiments';

export function getStaticPaths() {
  return EXPERIMENTS.map((exp) => ({
    params: { id: exp.id },
    props: { exp }
  }));
}

interface Props {
  exp: Experiment;
}

const { exp } = Astro.props;

// Find next and previous experiments for navigation
const currentIndex = EXPERIMENTS.findIndex((e) => e.id === exp.id);
const prevExp = currentIndex > 0 ? EXPERIMENTS[currentIndex - 1] : null;
const nextExp = currentIndex < EXPERIMENTS.length - 1 ? EXPERIMENTS[currentIndex + 1] : null;

// Find related experiments objects
const relatedExpObjects = exp.relatedExperiments
  ? EXPERIMENTS.filter((e) => exp.relatedExperiments?.includes(e.id))
  : [];
---

<Layout
  title={`${exp.id}: ${exp.title} — Chakaso Research Record`}
  description={`Empirical ledger record for experiment ${exp.id}: ${exp.summary}`}
  currentPath="/research/experiments"
>
  <article class="max-w-5xl mx-auto px-6 md:px-12 py-12">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 font-mono text-xs text-indigo-400">
      <a href="/research" class="hover:underline">Research</a>
      <span class="text-slate-600">/</span>
      <a href="/research/experiments" class="hover:underline">Experiments</a>
      <span class="text-slate-600">/</span>
      <span class="text-slate-300 font-semibold">{exp.id}</span>
    </nav>

    <!-- Header Block -->
    <header class="mb-12 pb-8 border-b border-white/[0.08]">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="font-mono text-sm font-bold px-3 py-1 rounded bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
          {exp.id}
        </span>
        <StatusBadge status={exp.status} size="md" />
        <span class="font-mono text-xs px-2.5 py-1 rounded bg-white/[0.05] text-slate-300 border border-white/10">
          {exp.domain}
        </span>
        <span class="font-mono text-xs px-2.5 py-1 rounded bg-purple-500/10 text-purple-300 border border-purple-500/20">
          {exp.evidenceClass}
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-white leading-tight editorial-title">
        {exp.title}
      </h1>

      <div class="mt-6 flex flex-wrap items-center gap-6 font-mono text-xs text-slate-400">
        <div>
          <span class="text-slate-500 uppercase tracking-wider text-[10px] block">Execution Date</span>
          <span class="text-slate-200">{exp.date}</span>
        </div>
        <div>
          <span class="text-slate-500 uppercase tracking-wider text-[10px] block">Last Verified</span>
          <span class="text-slate-200">{exp.lastVerifiedDate}</span>
        </div>
        <div>
          <span class="text-slate-500 uppercase tracking-wider text-[10px] block">Source Identifier</span>
          <span class="text-indigo-300">{exp.sourceIdentifier}</span>
        </div>
      </div>
    </header>

    <!-- Executive Summary Card -->
    <section aria-labelledby="summary-heading" class="mb-12 p-6 rounded-2xl border border-white/[0.08] bg-[#0c0e12]/80">
      <h2 id="summary-heading" class="font-mono text-xs uppercase tracking-wider text-indigo-400 font-semibold mb-2">
        Executive Summary
      </h2>
      <p class="text-base text-slate-300 leading-relaxed font-sans">
        {exp.summary}
      </p>
    </section>

    <!-- Research Question & Hypothesis -->
    <section aria-labelledby="question-heading" class="mb-12 grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="p-6 rounded-2xl border border-white/[0.08] bg-[#0c0e12]/60">
        <h2 id="question-heading" class="font-mono text-xs uppercase tracking-wider text-indigo-400 font-semibold mb-2">
          Research Question
        </h2>
        <p class="text-sm text-slate-200 font-sans leading-relaxed">
          {exp.question}
        </p>
      </div>

      <div class="p-6 rounded-2xl border border-white/[0.08] bg-[#0c0e12]/60">
        <h2 class="font-mono text-xs uppercase tracking-wider text-indigo-400 font-semibold mb-2">
          Experimental Design & Methodology
        </h2>
        <p class="text-sm text-slate-200 font-sans leading-relaxed">
          {exp.methodology}
        </p>
      </div>
    </section>

    <!-- Technical Setup (Model Config & Dataset Split) -->
    {(exp.modelConfig || exp.datasetSplit) && (
      <section aria-labelledby="config-heading" class="mb-12 p-6 rounded-2xl border border-white/[0.08] bg-[#0c0e12]/60">
        <h2 id="config-heading" class="font-mono text-xs uppercase tracking-wider text-slate-400 font-semibold mb-4">
          Protocol & Environment Parameters
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono text-xs">
          {exp.modelConfig && (
            <div class="p-4 rounded-xl border border-white/[0.04] bg-white/[0.01]">
              <span class="text-slate-500 text-[11px] block mb-1">MODEL CONFIGURATION</span>
              <span class="text-slate-200">{exp.modelConfig}</span>
            </div>
          )}
          {exp.datasetSplit && (
            <div class="p-4 rounded-xl border border-white/[0.04] bg-white/[0.01]">
              <span class="text-slate-500 text-[11px] block mb-1">DATASET & SPLIT STRATEGY</span>
              <span class="text-slate-200">{exp.datasetSplit}</span>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- Baselines & Comparisons (if present) -->
    {exp.baselines && exp.baselines.length > 0 && (
      <section aria-labelledby="baselines-heading" class="mb-12">
        <h2 id="baselines-heading" class="text-lg font-bold text-white mb-4 flex items-center gap-2">
          <span>Comparative Baselines</span>
        </h2>
        <div class="overflow-x-auto rounded-xl border border-white/[0.08] bg-[#0c0e12]">
          <table class="w-full text-left font-mono text-xs text-slate-300">
            <thead class="border-b border-white/[0.08] text-slate-500 uppercase text-[10px] tracking-wider">
              <tr>
                <th class="py-3 px-4">Baseline Name</th>
                <th class="py-3 px-4">Threshold / Score</th>
                <th class="py-3 px-4">Protocol Role</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.04]">
              {exp.baselines.map((b) => (
                <tr>
                  <td class="py-3 px-4 font-semibold text-white">{b.name}</td>
                  <td class="py-3 px-4 text-indigo-400 font-bold">{b.value}</td>
                  <td class="py-3 px-4 text-slate-400 font-sans">{b.detail || 'Comparative lower bound'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <!-- Measured Results -->
    <section aria-labelledby="results-heading" class="mb-12">
      <h2 id="results-heading" class="text-lg font-bold text-white mb-4 flex items-center gap-2">
        <span>Empirical Measurements</span>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {exp.results.map((res) => (
          <div class="p-5 rounded-xl border border-emerald-500/20 bg-emerald-950/15">
            <span class="font-mono text-xs text-emerald-400 font-medium block">{res.metric}</span>
            <div class="font-mono text-xl font-bold text-white mt-1">{res.value}</div>
            {res.baselineComparison && (
              <div class="text-xs text-slate-300 font-sans mt-2 pt-2 border-t border-emerald-500/10">
                {res.baselineComparison}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Scientific Interpretation -->
    {exp.interpretation && (
      <section aria-labelledby="interp-heading" class="mb-12 p-6 rounded-2xl border border-white/[0.08] bg-[#0c0e12]/80">
        <h2 id="interp-heading" class="font-mono text-xs uppercase tracking-wider text-emerald-400 font-semibold mb-2">
          Scientific Interpretation
        </h2>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-sans">
          {exp.interpretation}
        </p>
      </section>
    )}

    <!-- Empirical Limitations & Non-Claims -->
    <section aria-labelledby="limitations-heading" class="mb-12 p-6 rounded-2xl border border-amber-500/20 bg-amber-950/15">
      <h2 id="limitations-heading" class="font-mono text-xs uppercase tracking-wider text-amber-400 font-semibold mb-2">
        Empirical Limitations
      </h2>
      <p class="text-sm text-slate-300 font-sans leading-relaxed mb-6">
        {exp.limitations}
      </p>

      <div class="pt-4 border-t border-amber-500/20">
        <span class="font-mono text-xs uppercase tracking-wider text-amber-300 font-semibold block mb-2">
          What This Experiment Does NOT Establish (Non-Claims):
        </span>
        <ul class="list-disc list-inside text-sm text-slate-300 space-y-1.5 font-sans">
          {exp.nonClaims.map((nc) => (
            <li>{nc}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Related Experiments (if any) -->
    {relatedExpObjects.length > 0 && (
      <section aria-labelledby="related-heading" class="mb-12">
        <h2 id="related-heading" class="text-base font-bold text-white mb-4">
          Related Experiments in Sequence
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {relatedExpObjects.map((rel) => (
            <a
              href={`/research/experiments/${rel.id}`}
              class="p-4 rounded-xl border border-white/[0.08] bg-[#0c0e12]/60 hover:bg-[#121620] hover:border-indigo-500/40 transition-all flex flex-col justify-between group"
            >
              <div>
                <span class="font-mono text-xs font-bold text-indigo-400 block mb-1 group-hover:text-indigo-300">
                  {rel.id}
                </span>
                <div class="text-xs font-semibold text-slate-200 line-clamp-2 mb-2">
                  {rel.title}
                </div>
              </div>
              <div class="flex items-center justify-between font-mono text-[10px] text-slate-500">
                <span>{rel.status}</span>
                <span class="text-indigo-400">View &rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Prev / Next Navigation -->
    <footer class="pt-8 border-t border-white/[0.08] flex items-center justify-between">
      <div>
        {prevExp ? (
          <a
            href={`/research/experiments/${prevExp.id}`}
            class="inline-flex items-center gap-2 font-mono text-xs text-slate-400 hover:text-white transition-colors"
          >
            <span>&larr;</span>
            <span>{prevExp.id}: {prevExp.title.substring(0, 24)}...</span>
          </a>
        ) : (
          <span class="text-xs font-mono text-slate-600">&larr; First Experiment</span>
        )}
      </div>

      <a
        href="/research/experiments"
        class="font-mono text-xs px-3 py-1.5 rounded-lg border border-white/10 hover:border-white/20 text-slate-300 hover:text-white transition-colors"
      >
        All Experiments (35)
      </a>

      <div>
        {nextExp ? (
          <a
            href={`/research/experiments/${nextExp.id}`}
            class="inline-flex items-center gap-2 font-mono text-xs text-slate-400 hover:text-white transition-colors"
          >
            <span>{nextExp.id}: {nextExp.title.substring(0, 24)}...</span>
            <span>&rarr;</span>
          </a>
        ) : (
          <span class="text-xs font-mono text-slate-600">Latest Experiment &rarr;</span>
        )}
      </div>
    </footer>
  </article>
</Layout>

