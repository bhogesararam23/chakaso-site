---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';

const standards = [
  {
    num: '01',
    title: 'Experimental Preregistration',
    desc: 'An experiment record file (record.md) must be committed to the repository before a single training arm begins. The record declares the research question, hypothesis, protocol file, evaluation split, and statistical decision bands in advance, eliminating retrospective hypothesis generation (HARKing).'
  },
  {
    num: '02',
    title: 'Controlled Comparative Pairs',
    desc: 'When testing architectural or data hypotheses (e.g. rotary decoder vs standard transformer in E2611, or space-prefixed BPE in E2625), all other variables—parameter count, context window, optimizer moments, step budget, and distinct training documents—are held strictly identical.'
  },
  {
    num: '03',
    title: 'Multi-Seed Empirical Variance Bounds',
    desc: 'No single random seed can establish model superiority. In E2614, we empirically measured the multi-seed noise floor (σ = 0.00226 bpc on prose, 0.00337 on whole pack, and 0.01232 on mathematics). Claims of improvement must clear a 3σ noise threshold to be considered statistically defensible.'
  },
  {
    num: '04',
    title: 'Whole-Work Data Split Integrity (ADR-0042)',
    desc: 'To prevent subtle memorization masquerading as generalisation, evaluation splits are partitioned at the whole-work level. Chapters or excerpts from books present in the training set are strictly prohibited from appearing in the held-out validation or test partitions.'
  },
  {
    num: '05',
    title: 'Immutable Tokenizer Contracts',
    desc: 'A vocabulary cited by an experiment record is committed beside it (ADR-0044). The pre-tokenizer name, tie-breaking rules, and byte fallbacks form an immutable part of the vocabulary identity (ADR-0048). Runs cannot inherit drifting tokenizer configurations.'
  },
  {
    num: '06',
    title: 'Multiple Evaluation Baselines',
    desc: 'Every model evaluation is benchmarked against three reference tiers: (1) Uniform random prediction floor, (2) Unigram frequency distribution baseline, and (3) Preceding model architectures trained on the identical token budget. A model must beat all three before registering progress.'
  },
  {
    num: '07',
    title: 'Holm–Bonferroni Family-Wise Error Correction',
    desc: 'When multiple hypotheses or model arms are evaluated concurrently, raw p-values accumulate false positives. We enforce the Holm–Bonferroni step-down correction. When statistical tests do not separate model arms, the project explicitly documents that no claim of superiority can be made.'
  },
  {
    num: '08',
    title: 'Mandatory Negative-Result Reporting',
    desc: 'A failed experiment is recorded with the same fidelity as a successful one. In E2610, greedy decoding repetition was documented as human-distribution greedy collapse; in E2612, the prose penalty of technical mixtures was reported immediately. Negative results protect compute and preserve scientific integrity.'
  }
];

const evidenceClasses = [
  { label: 'Published', meaning: 'A source outside this repository states it; the source was read in abstract or full text.' },
  { label: 'Measured here', meaning: 'Computed in this repository from committed code and pinned inputs; the record names both.' },
  { label: 'Experimental', meaning: 'A preregistered run with a completed result in the repository; one seed unless specified.' },
  { label: 'Computed', meaning: 'Direct arithmetic on stated numbers, documented step-by-step.' },
  { label: 'Hypothesis', meaning: 'Falsifiable proposition, stating the precise run that would settle it; explicitly not believed until measured.' },
  { label: 'Decision', meaning: 'An engineering choice made with documented rationale that subsequent measurements may overturn.' }
];
---

<Layout
  title="Scientific Standards & Methodology — Chakaso"
  description="Institutional research methodology: experimental preregistration, multi-seed noise bounds, whole-work split integrity, and Holm–Bonferroni statistical testing."
  currentPath="/research/methodology"
>
  <div class="max-w-7xl mx-auto px-6 md:px-12 py-12">
    <!-- Breadcrumb & Header -->
    <div class="max-w-3xl mb-16">
      <div class="flex items-center gap-2 font-mono text-xs text-indigo-400 uppercase tracking-widest mb-4">
        <a href="/research" class="hover:underline">Research</a>
        <span class="text-slate-600">/</span>
        <span class="text-slate-300">Methodology</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-white leading-tight editorial-title">
        The Discipline of Measurement
      </h1>

      <p class="mt-4 text-base sm:text-lg text-slate-400 leading-relaxed font-sans">
        Independent research cannot rely on brute compute or marketing hype. Our scientific credibility rests on strict methodological protocols: preregistration, controlled comparisons, multi-seed variance tracking, and transparent disclosure of negative results.
      </p>
    </div>

    <!-- Evidence Classification System -->
    <div class="p-8 rounded-2xl border border-white/[0.08] bg-[#0c0e12]/80 mb-20">
      <span class="font-mono text-xs uppercase tracking-widest text-indigo-400 block mb-2">Epistemic Protocol</span>
      <h2 class="text-2xl font-bold text-white tracking-tight mb-4">The Evidence Classification System</h2>
      <p class="text-xs sm:text-sm text-slate-400 leading-relaxed font-sans max-w-3xl mb-8">
        To prevent hunches from acquiring the authority of measurements, every technical claim in Chakaso carries a mandatory evidence classification label:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {evidenceClasses.map((ec) => (
          <div class="p-4 rounded-xl border border-white/[0.05] bg-white/[0.02]">
            <span class="font-mono text-xs font-semibold text-indigo-300 uppercase tracking-wider block mb-1">{ec.label}</span>
            <p class="text-xs text-slate-400 font-sans leading-relaxed">{ec.meaning}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Core Research Standards (01 to 08) -->
    <div class="mb-20">
      <SectionHeader
        index="PROTOCOLS"
        tag="STANDARDS"
        title="Eight Methodological Pillars"
        description="The non-negotiable rules governing experiment design, execution, and reporting."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {standards.map((s) => (
          <div class="p-6 rounded-xl border border-white/[0.08] bg-[#0b0e14]/70 flex flex-col justify-between">
            <div>
              <div class="font-mono text-xs text-indigo-400 font-semibold mb-2">{s.num}</div>
              <h3 class="text-lg font-semibold text-white mb-2">{s.title}</h3>
              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed font-sans">
                {s.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Provenance & Reference Box -->
    <div class="p-6 rounded-xl border border-white/[0.07] bg-[#0c0e12]/60 text-xs font-mono text-slate-400 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <span class="text-indigo-400 font-semibold">Institutional Provenance: </span>
        <span>Ratified under ADR-0039, ADR-0042, and ADR-0052. Maintained in docs/research/hypotheses.md.</span>
      </div>
      <div class="shrink-0 text-slate-500">
        Status: Active Governance
      </div>
    </div>
  </div>
</Layout>
